FROM python:3.14.4-slim

ARG SOURCE_COMMIT_SHA
RUN python -c 'import os,re; assert re.fullmatch(r"[0-9a-f]{40}", os.environ["SOURCE_COMMIT_SHA"])'

LABEL org.opencontainers.image.revision="${SOURCE_COMMIT_SHA}"
ENV IMAGE_SOURCE_COMMIT_SHA="${SOURCE_COMMIT_SHA}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# The task workers only reconstruct already-frozen matrices, but the exact
# predecessor closure imports LightGBM and the collector validates one named
# Cloud Run execution.  Keep libgomp and the read-only gcloud client in this
# otherwise narrow research image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       apt-transport-https ca-certificates curl gnupg libgomp1 \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
       | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && printf '%s\n' \
       'deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main' \
       > /etc/apt/sources.list.d/google-cloud-sdk.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-cloud-cli \
    && ln -s /usr/local/bin/python3.14 /usr/local/bin/python3.11 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md SOURCE_COMMIT /app/
COPY src /app/src
COPY scripts/cloud_corpus_r6_broad_admission_tournament_v1.sh \
     scripts/run_corpus_r6_broad_admission_tournament_v1.py \
     scripts/run_corpus_r6_combined_frontier_reportfolio_v1.py \
     scripts/run_corpus_r6_combined_population_all_block_v1.py \
     scripts/run_corpus_r6_hard230_selector_bridge_v1.py \
     scripts/run_corpus_r6_construction_allocation_grade_v1.py \
     /app/scripts/

RUN test "$(cat /app/SOURCE_COMMIT)" = "${SOURCE_COMMIT_SHA}" \
    && pip install --no-cache-dir "numpy==2.5.1" "scipy==1.18.0" \
    && pip install --no-cache-dir --editable ".[gcp]"

# Installation leaves the shared job inert.  Every scientific phase is an
# explicit execution-level override made by the guarded host launcher.
CMD ["/bin/bash", "/app/scripts/cloud_corpus_r6_broad_admission_tournament_v1.sh", "container-help"]
